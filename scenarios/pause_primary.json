{
    "name": "pause_primary",
    "description": "Pause the primary long enough to trigger a view change",

    "duration_seconds": 30,

    "network": {
        "nodes": 7,
        "block_time_ms": 500,
        "consensus_timeout_ms": 1500
    },

    "traffic": {
        "type": "steady",
        "tps": 100,
        "target": "random"
    },

    "faults": [
        {
            "at_seconds": 10,
            "action": "pause_primary",
            "duration_ms": 5000
        }
    ]
}
